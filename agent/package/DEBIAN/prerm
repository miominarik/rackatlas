#!/bin/sh
set -e

case "$1" in
  remove|upgrade|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop rackatlas-agent.timer rackatlas-agent.service >/dev/null 2>&1 || true
      if [ "$1" = "remove" ]; then
        systemctl disable rackatlas-agent.timer >/dev/null 2>&1 || true
      fi
    fi
    ;;
esac

exit 0
