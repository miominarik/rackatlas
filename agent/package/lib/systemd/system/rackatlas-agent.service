[Unit]
Description=RackAtlas agent (sends metrics and serious log entries)
Documentation=https://github.com/miominarik/rackatlas
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rackatlas-agent
Group=rackatlas-agent
# Allows reading the journal without root.
SupplementaryGroups=systemd-journal
StateDirectory=rackatlas-agent
ExecStart=/usr/bin/rackatlas-agent
TimeoutStartSec=45
# Reading the memory accounting (PSS) of the processes of other users needs this one capability.
# The agent still runs as its own unprivileged user and cannot change anything.
AmbientCapabilities=CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_SYS_PTRACE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
