#!/bin/sh
#
# RackAtlas agent
#
# Collects CPU, memory and disk usage, network traffic, system facts (OS, kernel, pending updates), the busiest processes, the systemd services, plus serious log entries (journal errors, failed systemd units) and sends them to RackAtlas over HTTPS. Meant to run once a
# minute from the systemd timer. Nothing connects into the server.
#
# Usage: rackatlas-agent [--dry-run] [--version]
#
# The report has the same sections as App\Services\Ssh\MetricsParser::SCRIPT. Only the CPU
# part differs: the agent keeps the counters of the previous run, so the CPU usage is an
# average over the whole minute and not a one second snapshot.

set -u

VERSION="@VERSION@"
# Redis on this machine is read only when REDIS_PORT or REDIS_HOST is set in the configuration.
redis_run() {
  # The password goes through the environment, never through the command line.
  set -- --no-auth-warning ${REDIS_USER:+--user "$REDIS_USER"} -h "${REDIS_HOST:-127.0.0.1}" -p "${REDIS_PORT:-6379}" "$@"
  [ "$REDIS_TLS" = 1 ] && set -- --tls "$@"
  if command -v timeout >/dev/null 2>&1; then
    REDISCLI_AUTH="$REDIS_PASSWORD" timeout 5 redis-cli "$@" 2>&1 | head -c 100000
  else
    REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli "$@" 2>&1 | head -c 100000
  fi
}

redis_section() {
  if ! command -v redis-cli >/dev/null 2>&1; then
    echo '###REDIS_ERROR'; echo 'redis-cli is not installed (apt install redis-tools).'
    return
  fi

  INFO="$(redis_run INFO everything)"
  if ! printf '%s\n' "$INFO" | grep -q '^redis_version:'; then
    echo '###REDIS_ERROR'; printf '%s\n' "$INFO" | head -n 1 | cut -c1-300
    return
  fi

  echo '###REDIS_INFO'; printf '%s\n' "$INFO"
  if printf '%s\n' "$INFO" | grep -q '^cluster_enabled:1'; then
    echo '###REDIS_CLUSTER_INFO'; redis_run CLUSTER INFO
    echo '###REDIS_CLUSTER_NODES'; redis_run CLUSTER NODES
  fi
}

CONF="${RACKATLAS_CONF:-/etc/rackatlas-agent/agent.conf}"
STATE_DIR="${RACKATLAS_STATE:-/var/lib/rackatlas-agent}"
PROC_DIR="${RACKATLAS_PROC:-/proc}"
MAX_LOG_LINES=200
JOURNAL_LINES=2000
JOURNAL_BYTES=400000
PROC_TOP=5

case "${1:-}" in
  --version) echo "rackatlas-agent $VERSION"; exit 0 ;;
  --dry-run) DRY_RUN=1 ;;
  "") DRY_RUN="" ;;
  *) echo "usage: rackatlas-agent [--dry-run] [--version]" >&2; exit 2 ;;
esac

URL=""
TOKEN=""
REDIS_HOST=""
REDIS_PORT=""
REDIS_USER=""
REDIS_PASSWORD=""
REDIS_TLS=""
if [ -r "$CONF" ]; then
  # Only the known keys are read. The file is never executed.
  while IFS='=' read -r key value; do
    case "$key" in
      URL) URL="$value" ;;
      TOKEN) TOKEN="$value" ;;
      REDIS_HOST) REDIS_HOST="$value" ;;
      REDIS_PORT) REDIS_PORT="$value" ;;
      REDIS_USER) REDIS_USER="$value" ;;
      REDIS_PASSWORD) REDIS_PASSWORD="$value" ;;
      REDIS_TLS) REDIS_TLS="$value" ;;
    esac
  done < "$CONF"
fi
URL="${URL%/}"

if [ -z "$DRY_RUN" ] && { [ -z "$URL" ] || [ -z "$TOKEN" ]; }; then
  echo "rackatlas-agent: URL and TOKEN must be set in $CONF" >&2
  exit 2
fi

if [ -z "$DRY_RUN" ]; then
  case "$URL" in
    https://*) ;;
    *) echo 'rackatlas-agent: URL must use HTTPS' >&2; exit 2 ;;
  esac
  printf '%s\n' "$TOKEN" | grep -Eq '^ra_[A-Za-z0-9]{40}$' || {
    echo 'rackatlas-agent: invalid token format' >&2
    exit 2
  }
fi

mkdir -p "$STATE_DIR" 2>/dev/null || true
TMP="$(mktemp)" || exit 1
trap 'rm -f "$TMP" "$TMP.out" "$TMP.proc" "$TMP.proc-base" "$TMP.states" "$TMP.journal" "$TMP.units" "$TMP".cursor-*' EXIT

export LC_ALL=C

# Serious journal entries since the last successful report, one section per level.
# The cursor is saved only after RackAtlas accepted the report, so nothing is lost
# when the network is down.
journal_section() {
  name="$1"; priority="$2"; kind="$3"
  cursor_file="$STATE_DIR/cursor-$kind"

  if [ -s "$cursor_file" ]; then
    out="$(journalctl -p "$priority" --after-cursor "$(cat "$cursor_file")" -o short-iso --no-pager --show-cursor -n "$MAX_LOG_LINES" 2>/dev/null)"
  else
    out="$(journalctl -p "$priority" --since '-10 min' -o short-iso --no-pager --show-cursor -n "$MAX_LOG_LINES" 2>/dev/null)"
  fi

  cursor="$(printf '%s\n' "$out" | sed -n 's/^-- cursor: //p' | tail -n 1)"
  [ -n "$cursor" ] && printf '%s\n' "$cursor" > "$TMP.cursor-$kind"

  echo "###$name"
  # The agent's own failures ("Failed to start rackatlas-agent.service", "could not reach ...") are
  # not news about the server, so they are not reported back.
  printf '%s\n' "$out" | grep -v '^-- ' | grep -v 'rackatlas-agent'
}

# CPU usage between two readings of the counters in /proc/stat. The first reading is the
# one saved by the previous run (an average over the whole time between the runs). Without
# a recent, valid one (first run, after a reboot, long pause) a one second sample is used.
cpu_total() { awk '{ s = 0; for (i = 2; i <= 9; i++) s += $i; printf "%.0f\n", s }'; }

# One line per process: pid, start time, CPU ticks and (with "full") name, RSS and PSS in kB.
# The first line, "T <ticks>", is the CPU time of the whole machine, so that the ticks of a
# process can be turned into a share of the machine. PSS (shared memory split fairly between
# the processes that use it) needs the ptrace capability, see the .service file. Without it
# the resident size is used.
PAGE_KB=$(( $(getconf PAGESIZE 2>/dev/null || echo 4096) / 1024 ))
MAX_PSS_PROCESSES=2000

proc_scan() {
  mode="$1"; count=0
  read -r line < "$PROC_DIR/stat"
  echo "T $(printf '%s\n' "$line" | cpu_total)"
  for dir in "$PROC_DIR"/[0-9]*; do
    pid="${dir##*/}"
    read -r stat < "$dir/stat" 2>/dev/null || continue
    # The name in the first field may contain spaces and brackets, so cut after the last ")".
    set -- ${stat##*) }
    [ "$#" -ge 20 ] || continue
    ticks=$(( ${12} + ${13} ))
    start="${20}"

    if [ "$mode" != full ]; then
      echo "$pid $start $ticks"
      continue
    fi

    name=""
    read -r name < "$dir/comm" 2>/dev/null || true
    name="${name%% *}"
    [ -n "$name" ] || name="?"

    rss=0
    read -r _ pages _ < "$dir/statm" 2>/dev/null || pages=0
    rss=$(( pages * PAGE_KB ))
    pss="$rss"

    count=$(( count + 1 ))
    if [ "$count" -le "$MAX_PSS_PROCESSES" ]; then
      { while read -r key value _; do
          if [ "$key" = "Pss:" ]; then pss="$value"; break; fi
        done < "$dir/smaps_rollup"; } 2>/dev/null
    fi

    echo "$pid $start $ticks $name $rss $pss"
  done
}

# Groups the processes by name and keeps the busiest ones: the five that used the most CPU and
# the five that held the most memory since the previous run. Output: name count cpu% pss_kb,
# where cpu% is the share of the whole machine, like the CPU usage of the report.
proc_top() {
  awk -v top="$PROC_TOP" '
    FNR == 1 { file++ }
    file == 1 {
      if ($1 == "T") { base_total = $2 } else { before[$1 " " $2] = $3 }
      next
    }
    $1 == "T" { total = $2; next }
    {
      key = $1 " " $2
      delta = (key in before) ? $3 - before[key] : $3
      if (delta < 0) delta = 0
      name = $4
      sub(/\/.*$/, "", name)
      cpu[name] += delta
      count[name]++
      mem[name] += $6
    }
    END {
      elapsed = total - base_total
      if (elapsed <= 0) exit
      for (round = 0; round < 2; round++) {
        for (n = 0; n < top; n++) {
          best = ""
          for (name in count) {
            if (name in picked) continue
            value = round == 0 ? cpu[name] : mem[name]
            if (best == "" || value > (round == 0 ? cpu[best] : mem[best])) best = name
          }
          if (best == "" || (round == 0 && cpu[best] == 0)) break
          picked[best] = 1
          order[++total_picked] = best
        }
      }
      for (i = 1; i <= total_picked; i++) {
        name = order[i]
        pct = cpu[name] * 100 / elapsed
        if (pct > 100) pct = 100
        printf "%s %d %.2f %d\n", name, count[name], pct, mem[name]
      }
    }
  ' "$1" "$2"
}

# Static facts about the machine, as key=value lines. Every value is optional.
system_section() {
  host="$(cat "$PROC_DIR/sys/kernel/hostname" 2>/dev/null)"
  [ -n "$host" ] && echo "hostname=$host"
  os="$(sed -n 's/^PRETTY_NAME=//p' /etc/os-release 2>/dev/null | head -n 1 | tr -d '"')"
  [ -n "$os" ] && echo "os=$os"
  kernel="$(cat "$PROC_DIR/sys/kernel/osrelease" 2>/dev/null)"
  [ -n "$kernel" ] && echo "kernel=$kernel"
  arch="$(uname -m 2>/dev/null)"
  [ -n "$arch" ] && echo "arch=$arch"
  model="$(awk -F: '/^(model name|Model|Hardware)[ \t]*:/ { sub(/^[ \t]+/, "", $2); print $2; exit }' "$PROC_DIR/cpuinfo" 2>/dev/null)"
  [ -n "$model" ] && echo "cpu_model=$model"
  if command -v systemd-detect-virt >/dev/null 2>&1; then
    virt="$(systemd-detect-virt 2>/dev/null)"
    [ -n "$virt" ] && echo "virtualization=$virt"
  fi
  if [ -r /var/lib/update-notifier/updates-available ]; then
    awk '/can be applied/ { print "updates=" $1 } /security update/ { print "security_updates=" $1 }' /var/lib/update-notifier/updates-available
  fi
  if [ -e /run/reboot-required ]; then echo "reboot_required=1"; else echo "reboot_required=0"; fi
}

# Network traffic of the physical interfaces as bytes per second, averaged since the previous run.
# The counters are kept in the state directory like the CPU ones. Prints nothing on the first run.
network_section() {
  now="$(cut -d' ' -f1 "$PROC_DIR/uptime")"
  counters="$(awk '
    NR > 2 {
      gsub(/:/, " ")
      if ($1 ~ /^(lo|docker|veth|br-|virbr|cni|flannel|cali|kube|tap)/) next
      rx += $2; tx += $10
    }
    END { printf "%.0f %.0f\n", rx, tx }' "$PROC_DIR/net/dev" 2>/dev/null)"
  [ -n "$counters" ] || return 0

  prev_file="$STATE_DIR/net-prev"
  if [ -s "$prev_file" ] && [ -n "$(find "$prev_file" -mmin -5 2>/dev/null)" ]; then
    awk -v now="$now" -v cur="$counters" '
      BEGIN { split(cur, c, " ") }
      { dt = now - $1; if (dt > 0 && c[1] >= $2 && c[2] >= $3) printf "%.0f %.0f\n", (c[1] - $2) / dt, (c[2] - $3) / dt }
    ' "$prev_file"
  fi

  if [ -z "$DRY_RUN" ]; then
    echo "$now $counters" > "$prev_file.tmp" 2>/dev/null && mv "$prev_file.tmp" "$prev_file" 2>/dev/null
  fi
}

# The systemd services, one per line: unit|active|sub|unit file state|description. Only names that are
# safe to hand to journalctl are listed.
services_section() {
  systemctl list-unit-files --type=service --no-legend --plain --no-pager 2>/dev/null > "$TMP.states"
  systemctl list-units --type=service --all --no-legend --plain --no-pager 2>/dev/null > "$TMP.units"
  awk '
    FNR == NR { state[$1] = $2; next }
    $1 ~ /^[A-Za-z0-9][A-Za-z0-9:_.@\\-]*\.service$/ && $2 != "not-found" && $1 != "rackatlas-agent.service" {
      desc = ""
      for (i = 5; i <= NF; i++) desc = desc (i > 5 ? " " : "") $i
      gsub(/\|/, "/", desc)
      printf "%s|%s|%s|%s|%s\n", $1, $3, $4, ($1 in state ? state[$1] : ""), desc
    }
  ' "$TMP.states" "$TMP.units" | head -n 400
}

# RackAtlas lists in its answer the services whose journal somebody asked for ("journal":["a.service"]).
# The end of each one is sent in a separate request, at most two per run. Only plain unit names are accepted.
send_requested_journals() {
  command -v journalctl >/dev/null 2>&1 || return 0
  units="$(sed -n 's/.*"journal":\[\([^]]*\)\].*/\1/p' "$TMP.out" | tr -d '"' | tr ',' ' ')"
  for unit in $units; do
    printf '%s\n' "$unit" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9:_.@-]*\.service$' || continue
    journalctl -u "$unit" -n "$JOURNAL_LINES" -o short-iso --no-pager 2>/dev/null | grep -v '^-- ' | cut -c1-500 | tail -c "$JOURNAL_BYTES" > "$TMP.journal"
    printf 'Authorization: Bearer %s\n' "$TOKEN" | curl -sS -o /dev/null --max-time 15 \
      -X POST \
      -H @- \
      -H "X-Agent-Version: $VERSION" \
      -H "X-Unit: $unit" \
      -H 'Content-Type: text/plain' \
      --data-binary @"$TMP.journal" \
      "$URL/api/agent/journal" || echo "rackatlas-agent: could not send the journal of $unit" >&2
  done
}

CPU_PREV_FILE="$STATE_DIR/cpu-prev"
CPU_NOW="$(head -n1 "$PROC_DIR/stat")"
CPU_FIRST=""

if [ -s "$CPU_PREV_FILE" ] && [ -n "$(find "$CPU_PREV_FILE" -mmin -5 2>/dev/null)" ]; then
  CPU_PREVIOUS="$(head -n1 "$CPU_PREV_FILE")"
  if [ "$(printf '%s\n' "$CPU_NOW" | cpu_total)" -gt "$(printf '%s\n' "$CPU_PREVIOUS" | cpu_total)" ] 2>/dev/null; then
    CPU_FIRST="$CPU_PREVIOUS"
  fi
fi

if [ -z "$CPU_FIRST" ]; then
  CPU_FIRST="$CPU_NOW"
  sleep 1
  CPU_NOW="$(head -n1 "$PROC_DIR/stat")"
fi

if [ -z "$DRY_RUN" ]; then
  printf '%s\n' "$CPU_NOW" > "$CPU_PREV_FILE.tmp" 2>/dev/null && mv "$CPU_PREV_FILE.tmp" "$CPU_PREV_FILE" 2>/dev/null
fi

# CPU use per process needs the counters of the previous run, like the CPU usage above.
PROC_PREV_FILE="$STATE_DIR/proc-prev"
PROC_BASE="$PROC_PREV_FILE"
if ! { [ -s "$PROC_PREV_FILE" ] && [ -n "$(find "$PROC_PREV_FILE" -mmin -5 2>/dev/null)" ]; }; then
  PROC_BASE="$TMP.proc-base"
  proc_scan ticks > "$PROC_BASE"
  sleep 1
fi
proc_scan full > "$TMP.proc"

{
  echo '###CPU1'; echo "$CPU_FIRST"
  echo '###CPU2'; echo "$CPU_NOW"
  echo '###LOAD'; cat "$PROC_DIR/loadavg"
  echo '###CORES'; nproc 2>/dev/null || grep -c '^processor' "$PROC_DIR/cpuinfo"
  echo '###MEM'; grep -E '^(MemTotal|MemFree|MemAvailable|Buffers|Cached|SwapTotal|SwapFree):' "$PROC_DIR/meminfo"
  echo '###UPTIME'; cut -d' ' -f1 "$PROC_DIR/uptime"
  echo '###DISK'; df -PT -B1 -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs -x iso9660 2>/dev/null | tail -n +2

  echo '###PROCESSES'; proc_top "$PROC_BASE" "$TMP.proc"
  echo '###SYSTEM'; system_section
  echo '###NETWORK'; network_section

  if command -v journalctl >/dev/null 2>&1; then
    journal_section JOURNAL_CRITICAL 'emerg..crit' critical
    journal_section JOURNAL_ERROR 'err..err' error
  fi

  if [ -n "$REDIS_HOST$REDIS_PORT" ]; then
    redis_section
  fi

  if command -v systemctl >/dev/null 2>&1; then
    SERVICES="$(services_section)"
    if [ -n "$SERVICES" ]; then
      echo '###SERVICES'; printf '%s\n' "$SERVICES"
    fi

    echo '###FAILED_UNITS'
    systemctl --failed --no-legend --plain --no-pager 2>/dev/null | grep -v 'rackatlas-agent\.service' | head -n 30
  fi
} > "$TMP"

# Saved only now: the report above has read the previous counters from the same file.
if [ -z "$DRY_RUN" ]; then
  awk '{ print $1, $2, $3 }' "$TMP.proc" > "$PROC_PREV_FILE.tmp" 2>/dev/null && mv "$PROC_PREV_FILE.tmp" "$PROC_PREV_FILE" 2>/dev/null
fi

if [ -n "$DRY_RUN" ]; then
  cat "$TMP"
  exit 0
fi

status="$(printf 'Authorization: Bearer %s\n' "$TOKEN" | curl -sS -o "$TMP.out" -w '%{http_code}' --max-time 25 --retry 2 --retry-delay 2 \
  -X POST \
  -H @- \
  -H "X-Agent-Version: $VERSION" \
  -H 'Content-Type: text/plain' \
  --data-binary @"$TMP" \
  "$URL/api/agent/ingest")" || {
  echo "rackatlas-agent: could not reach $URL" >&2
  exit 1
}

case "$status" in
  2??)
    # Accepted: remember how far we have read the journal.
    for file in "$TMP".cursor-*; do
      [ -e "$file" ] || continue
      kind="${file##*.cursor-}"
      mv "$file" "$STATE_DIR/cursor-$kind"
    done
    send_requested_journals
    ;;
  401)
    echo "rackatlas-agent: the token was rejected. Install the agent again with a new token." >&2
    exit 1
    ;;
  *)
    echo "rackatlas-agent: RackAtlas answered $status: $(head -c 300 "$TMP.out")" >&2
    exit 1
    ;;
esac
