#!/bin/sh
#
# Starts the terminal service of RackAtlas with the binary that fits this machine.
# The package carries one binary per architecture, so it stays a single architecture independent package.

case "$(uname -m)" in
  x86_64|amd64) ARCH=amd64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *) echo "rackatlas-terminal: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

exec "/usr/lib/rackatlas-agent/rackatlas-terminal-$ARCH" "$@"
